{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["frontend/dashboard/src/**/*.ts", "frontend/dashboard/src/**/*.tsx"]
}
